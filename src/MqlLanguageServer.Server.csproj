<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MqlLanguageServer</RootNamespace>
    <AssemblyName>mql-lsp-server</AssemblyName>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;NU1903;NU1902</NoWarn>

    <!-- Enable argument passing for single-file apps -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- NuGet Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mql-lsp-server</ToolCommandName>
    <PackageId>mql-language-server</PackageId>
    <Version>1.11.4</Version>
    <Authors>MQL Language Server Team</Authors>
    <Description>Language Server Protocol implementation for MQL4 and MQL5 (MetaTrader 4/5)</Description>
    <PackageTags>lsp;mql4;mql5;metatrader;language-server</PackageTags>
    <RepositoryUrl>https://github.com/davalillo/mql-language-server</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- BuildConstants.cs is now a static file in the project root -->

  <!-- Override settings when packing as NuGet Tool -->
  <Target Name="PackTool" AfterTargets="Build">
    <PropertyGroup>
      <SelfContained>false</SelfContained>
      <PublishSingleFile>false</PublishSingleFile>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="MqlLanguageServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="OmniSharp.Extensions.LanguageProtocol" Version="0.19.9" />
    <PackageReference Include="OmniSharp.Extensions.JsonRpc" Version="0.19.9" />
    <PackageReference Include="OmniSharp.Extensions.LanguageServer" Version="0.19.9" />
    <PackageReference Include="OmniSharp.Extensions.LanguageServer.Shared" Version="0.19.9" />
    <PackageReference Include="Serilog" Version="4.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Antlr4BuildTasks" Version="12.10" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ANTLR Grammar Generation -->
  <ItemGroup>
    <Antlr4 Include="Mql4/Grammar/Mql4Grammar.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>true</Listener>
      <Visitor>true</Visitor>
      <Package>Mql4Grammar</Package>
      <AntOutDir>$(MSBuildProjectDirectory)/Parser/Generated/Mql4</AntOutDir>
    </Antlr4>
    <Antlr4 Include="Mql5/Grammar/Mql5Grammar.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>true</Listener>
      <Visitor>true</Visitor>
      <Package>Mql5Grammar</Package>
      <AntOutDir>$(MSBuildProjectDirectory)/Parser/Generated/Mql5</AntOutDir>
    </Antlr4>
  </ItemGroup>

</Project>
